# Environment Name (development, staging, production)
ENVIRONMENT=development

# Application Details
PROJECT_NAME="Smart Internship Management Backend"
API_V1_STR=/api

# CORS Configuration (comma-separated list of allowed origins)
# Add your frontend application URLs here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Database Configuration
# For local development with SQLite:
DATABASE_URL=sqlite:///./sql_app.db

# For PostgreSQL in production/staging (replace with your actual credentials in .env):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/smart_internship_db

# JWT Authentication Configuration
# Set a strong, random secret key in production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
