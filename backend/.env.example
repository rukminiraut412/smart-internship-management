# Backend Environment Variables
ENVIRONMENT=development
PROJECT_NAME="Smart Internship Management Backend"
API_V1_STR=/api

# Database connection URL (defaults to local SQLite database)
DATABASE_URL=sqlite:///./sql_app.db

# Allowed CORS origins (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Authentication (Change secret key in production)
JWT_SECRET_KEY=dev-secret-key-change-in-production-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
